+            self.req_indices,
+            idx_s,
+            self.seq_lens,
+            cu_s,
+            ok_s,
+            ov_s,
+            BATCH,
+            topk_s,
+            **self.tier_kwargs(),
+        )
+        torch.cuda.synchronize()
+        written = torch.zeros(BATCH * stride_s, dtype=torch.bool, device=dev)
+        for b in range(BATCH):
+            for c in range(topk_s):
+                pos = int(idx_s[b, c])

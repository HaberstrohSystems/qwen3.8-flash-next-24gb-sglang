+    def _pool_env(self, lazy):
+        env = dict(os.environ)
+        env.pop("SGLANG_KV_LAZY", None)
+        env["SGLANG_KV_TIERS_W"] = str(R)
+        if lazy:
+            env["SGLANG_KV_LAZY"] = "1"
+            env["SGLANG_KV_LAZY_FLOOR"] = "512"
+        return env

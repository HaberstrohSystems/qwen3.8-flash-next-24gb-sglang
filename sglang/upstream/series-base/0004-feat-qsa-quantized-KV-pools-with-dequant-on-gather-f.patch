+                pool.set_kv_buffer(None, loc, xk, xv, layer_id_override=0, **bad_kw)
+        with self.assertRaises(NotImplementedError):
+            pool.get_cpu_copy(loc)
+        with self.assertRaises(NotImplementedError):
+            pool.load_cpu_copy(None, loc)

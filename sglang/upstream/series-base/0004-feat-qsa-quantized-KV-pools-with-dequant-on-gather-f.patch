+        )
+        kb, vb = pool.get_kv_size_bytes()
+        self.assertEqual(kb, 2 * rows * (HEADS * DIM + HEADS * NG * 2))
+        self.assertEqual(vb, kb)
+        if lazy:
+            o = pool._post_capture_owner
